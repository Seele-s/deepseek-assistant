# ===== DeepSeek 智能问答助手 环境配置 =====
# ！！！注意：此文件包含敏感信息，切勿提交到 Git 或打包发给他人 ！！！

# ---- DeepSeek 密钥（泄露过请立刻去官网重置）----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
REASONER_MODEL=deepseek-reasoner
TEMPERATURE=1.0

# ---- JWT 鉴权 ----
SECRET_KEY=suibian_xie_yige_chang_zifuchuan
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库：默认 SQLite，不用改 ----
# 切换 MySQL：先启动 MySQL 服务并执行 scripts/init_mysql.sql，再放开下面这行
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/deepseek_chat?charset=utf8mb4

# ---- 上下文窗口 ----
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=24000

# ---- 上传限制 ----
MAX_UPLOAD_MB=20

# ---- CORS 白名单 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
